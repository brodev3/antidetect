{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "declaration": true,
    "declarationMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": ["apps/api/src/**/*.ts", "packages/contracts/src/**/*.ts"]
}
